<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción de datos para Android 12+ (API 31+).
   Controla la transferencia en nube y dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir bases de datos locales y SharedPreferences cifradas de la copia automática en nube -->
        <exclude domain="database" path="tortilleria_db"/>
        <exclude domain="database" path="tortilleria_db-wal"/>
        <exclude domain="database" path="tortilleria_db-shm"/>
        <exclude domain="sharedpref" path="EncryptedSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Permitir transferencia segura de dispositivo a dispositivo (Restore Credentials / Cable setup) -->
        <include domain="database" path="tortilleria_db"/>
        <include domain="database" path="tortilleria_db-wal"/>
        <include domain="database" path="tortilleria_db-shm"/>
    </device-transfer>
</data-extraction-rules>
