<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de respaldo y seguridad para app Tortilleria Derek (Offline-First).
   Protege la base de datos local y preferencias cifradas frente a respaldos automáticos no controlados en nube.
-->
<full-backup-content>
    <exclude domain="database" path="tortilleria_db"/>
    <exclude domain="database" path="tortilleria_db-wal"/>
    <exclude domain="database" path="tortilleria_db-shm"/>
    <exclude domain="sharedpref" path="EncryptedSharedPreferences.xml"/>
</full-backup-content>
